title: Traduire le MLD en modèle objet
---
classDiagram
    class User{
        -int id
        -string email
        -string mot_de_passe
        -string role

    }
    class Auteur{
        -int id
        -string nom
        -string prenom
        -string biographie
        -string avatar

    }
    class Article {
        -int id
        -string titre
        -string contenu
        -string statut
        -int vues
        -DateTime date_creation
    }
    class Categorie {
        -int id
        -string nom
        -string couleur
        -string icone
    }